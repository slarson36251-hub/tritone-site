# Build-time only. Never commit real values.
# Shows come ONLY from the public "Music" calendar. Never point this at the
# Hummingbird Hut calendar: its event locations hold the studio address.
MUSIC_CALENDAR_ID=226gr9pmhmg1mcrfmm1fre0nf4@group.calendar.google.com
GOOGLE_CALENDAR_API_KEY=
# Beta-site feedback overlay (Scott only, tritone-site.web.app + ?feedback=on). Public,
# referrer-restricted Firebase web key; CI takes it from the FEEDBACK_API_KEY repo variable.
PUBLIC_FEEDBACK_API_KEY=
# Mix review (/review?k=...): public base URL of the NAS stream server that signs and streams the
# mixes and takes voice notes (studio/review-stream in the tritone repo). No trailing slash.
# Leave empty and /review shows "isn't set up yet"; /review?demo=1 works without it.
PUBLIC_REVIEW_STREAM_URL=
