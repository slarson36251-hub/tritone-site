---
// Client mix review: /review?k=<reviewKey>[&v=<versionId>]  (docs/mix-review-contract.md).
// A private, unlinked tool page: noindex/nofollow (so it never reaches the sitemap), no referrer,
// not counted by src/lib/track.ts. Static shell; everything is loaded in the browser by
// src/lib/review/app.ts from Firestore (review, versions, notes) and the NAS stream server (audio).
// /review?demo=1 runs the whole page on a generated test tune with nothing fetched or sent.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import logo from "../assets/logo/tritone-wordmark-white.png";
import "../lib/review/review.css";
---
<Base
  title="Mix Review · Tritone Productions"
  description="Private mix review from Tritone Productions: listen to the mix with the session markers and leave time-stamped notes, typed or spoken over the music."
  noindex
  nofollow
  bare
>
  <meta slot="head" name="referrer" content="no-referrer" />
  <header slot="header" class="rv-header">
    <div class="rv-shell rv-header-row">
      <Image src={logo} alt="Tritone Productions, Oakland, California" class="rv-logo" widths={[240, 480]} sizes="200px" loading="eager" />
      <div class="rv-header-right">
        <span class="rv-private">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
          <span class="rv-private-text">Private review</span>
        </span>
        <button type="button" id="rv-name-btn" class="rv-namebtn">
          <span id="rv-name-initial" class="rv-avatar" aria-hidden="true">?</span>
          <span id="rv-name-text">Add your name</span>
        </button>
      </div>
    </div>
  </header>

  <div id="rv" class="rv rv-shell" data-state="loading">
    <p class="rv-only-loading rv-loading" role="status">Loading the mix…</p>

    <section class="rv-only-error rv-errorpage" aria-live="polite">
      <h1 id="rv-err-title" class="rv-disp rv-h1">This review link isn't active</h1>
      <p id="rv-err-body" class="rv-lead">The link may have been mistyped, or the review has been closed. Check the link in your email, or reply to Scott for a fresh one.</p>
      <button type="button" id="rv-err-retry" class="rv-btn rv-btn-primary" hidden>Try again</button>
      <p class="rv-dim"><a href="mailto:scott@tritone-productions.com">scott@tritone-productions.com</a></p>
    </section>
    <noscript><p class="rv-lead">The mix review needs JavaScript. Turn it on, or open the link in Safari or Chrome.</p></noscript>

    <div class="rv-only-ready">
      <p id="rv-demo" class="rv-demo" hidden><strong>Demo.</strong> A made-up review with a test tune. Nothing here is real and nothing is sent.</p>

      <section class="rv-titleblock">
        <p id="rv-artist" class="rv-eyebrow">Mix review</p>
        <h1 id="rv-title" class="rv-disp rv-h1">Mix review</h1>
        <div class="rv-versionrow">
          <span id="rv-version-pill" class="rv-vpill"></span>
          <label class="rv-vselect" hidden>
            <span class="rv-sr">Version</span>
            <select id="rv-version"></select>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
          </label>
          <span class="rv-dim">Bounced from Logic · markers from the session</span>
        </div>
      </section>

      <div class="rv-cols">
        <section class="rv-player" aria-label="Player">
          <div class="rv-readout">
            <div class="rv-readout-main">
              <span id="rv-now" class="rv-now">0:00.0</span>
              <div class="rv-secnav">
                <button type="button" id="rv-prev" class="rv-round" aria-label="Previous marker">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
                </button>
                <span id="rv-sec" class="rv-secname" aria-live="off">—</span>
                <button type="button" id="rv-next" class="rv-round" aria-label="Next marker">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                </button>
              </div>
              <span id="rv-bb" class="rv-bb">Bar 1 · Beat 1</span>
            </div>
            <span id="rv-total" class="rv-total"></span>
          </div>

          <nav id="rv-markers" class="rv-markers" aria-label="Logic markers"></nav>

          <div class="rv-hintrow">
            <span class="rv-hint">Tap or drag anywhere on the waveform to set where it plays from.</span>
            <button type="button" id="rv-zoom" class="rv-toggle" aria-pressed="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path><path d="M8 11h6"></path><path d="M11 8v6"></path></svg>
              <span id="rv-zoom-label">Zoom to section</span>
            </button>
          </div>

          <div class="rv-wavebox">
            <div id="rv-bubble" class="rv-bubble" aria-hidden="true"></div>
            <div id="rv-wave" class="rv-wave" role="slider" tabindex="0" aria-label="Playback position" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0">
              <canvas id="rv-canvas" class="rv-canvas" aria-hidden="true"></canvas>
              <div id="rv-playhead" class="rv-playhead" aria-hidden="true"><span class="rv-knob"></span></div>
            </div>
            <div id="rv-lane" class="rv-lane" aria-label="Notes on the timeline"></div>
            <div id="rv-ticks" class="rv-ticks" aria-hidden="true"></div>
          </div>

          <div class="rv-transport">
            <div role="group" aria-label="Transport" class="rv-transport-main">
              <button type="button" id="rv-back5" class="rv-step" aria-label="Back 5 seconds">−5s</button>
              <button type="button" id="rv-back1" class="rv-step" aria-label="Back 1 second">−1s</button>
              <button type="button" id="rv-play" class="rv-play" aria-label="Play"></button>
              <button type="button" id="rv-fwd1" class="rv-step" aria-label="Forward 1 second">+1s</button>
              <button type="button" id="rv-fwd5" class="rv-step" aria-label="Forward 5 seconds">+5s</button>
            </div>
            <div class="rv-transport-side">
              <button type="button" id="rv-replay" class="rv-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
                Replay last 5s
              </button>
              <button type="button" id="rv-loop" class="rv-toggle rv-toggle-lg" aria-pressed="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg>
                <span id="rv-loop-label">Loop this section</span>
              </button>
            </div>
          </div>
          <p id="rv-player-msg" class="rv-msg" role="status"></p>

          <button type="button" id="rv-capture" class="rv-capture">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
            Capture note at <span id="rv-capture-time">0:00.0</span>
          </button>

          <section id="rv-composer" class="rv-composer" aria-labelledby="rv-c-title" hidden>
            <div class="rv-c-head">
              <h2 id="rv-c-title" class="rv-disp rv-h3">Note at 0:00.0</h2>
              <span id="rv-c-where" class="rv-dim"></span>
            </div>
            <div class="rv-c-range">
              <span class="rv-c-rangeitem">
                <span class="rv-dim">Clip starts</span>
                <button type="button" id="rv-c-from-minus" class="rv-mini" aria-label="Clip starts half a second earlier">−</button>
                <strong id="rv-c-from">0:00.0</strong>
                <button type="button" id="rv-c-from-plus" class="rv-mini" aria-label="Clip starts half a second later">+</button>
              </span>
              <span class="rv-c-rangeitem">
                <span class="rv-dim">Note at</span>
                <button type="button" id="rv-c-t-minus" class="rv-mini" aria-label="Note half a second earlier">−</button>
                <strong id="rv-c-to">0:00.0</strong>
                <button type="button" id="rv-c-t-plus" class="rv-mini" aria-label="Note half a second later">+</button>
              </span>
            </div>
            <p class="rv-dim rv-small">The clip is the part you just heard. Scott hears it with your note. You can also drag the note's bar under the waveform.</p>
            <div role="group" aria-label="Note type" class="rv-c-modes">
              <button type="button" id="rv-c-type" class="rv-toggle rv-toggle-lg" aria-pressed="true">Type it</button>
              <button type="button" id="rv-c-talk" class="rv-toggle rv-toggle-lg" aria-pressed="false">Talk over the music</button>
            </div>
            <div id="rv-c-talkpanel" class="rv-c-talk" hidden>
              <div class="rv-c-recrow">
                <button type="button" id="rv-c-rec" class="rv-rec" aria-pressed="false">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"></rect><path d="M5 10a7 7 0 0 0 14 0"></path><path d="M12 17v5"></path></svg>
                  <span id="rv-c-rec-label">Start talking</span>
                </button>
                <button type="button" id="rv-c-listen" class="rv-btn" hidden>Listen back</button>
              </div>
              <p id="rv-c-recstatus" class="rv-dim rv-tabular" aria-live="polite"></p>
              <p class="rv-dim rv-small">Headphones help: without them the mic also hears the music.</p>
            </div>
            <div class="rv-field">
              <label for="rv-c-text" id="rv-c-textlabel">What would you like changed here?</label>
              <textarea id="rv-c-text" rows="3" maxlength="4000" placeholder="e.g. Bring the ride up under the solo"></textarea>
            </div>
            <p id="rv-c-msg" class="rv-msg" role="status"></p>
            <div class="rv-c-actions">
              <button type="button" id="rv-c-save" class="rv-btn rv-btn-primary" disabled>Save draft</button>
              <button type="button" id="rv-c-cancel" class="rv-btn rv-btn-ghost">Cancel</button>
              <button type="button" id="rv-c-delete" class="rv-btn rv-btn-ghost rv-push" hidden>Delete draft</button>
            </div>
          </section>

          <p class="rv-keys">On a keyboard: Space play/pause · ← → 1s · Shift ← → 5s · R replay · L loop · N note</p>
        </section>

        <aside class="rv-notes" aria-label="Notes">
          <section class="rv-block" aria-labelledby="rv-drafts-h">
            <div class="rv-blockhead">
              <h2 id="rv-drafts-h" class="rv-disp rv-h2">Your drafts</h2>
              <span id="rv-drafts-count" class="rv-dim"></span>
            </div>
            <p id="rv-drafts-empty" class="rv-dim">No drafts yet. Play the mix, and when something needs changing tap <strong>Capture note</strong>. Drafts stay on this device until you send them.</p>
            <div id="rv-drafts" class="rv-list"></div>
            <button type="button" id="rv-send" class="rv-btn rv-btn-primary rv-send" hidden>Send feedback</button>
            <p id="rv-send-msg" class="rv-msg" role="status" hidden></p>
          </section>

          <section class="rv-block" aria-labelledby="rv-sent-h">
            <div id="rv-sent-ok" class="rv-sentok" role="status" hidden>
              <strong class="rv-disp">Sent. Thank you</strong>
              <span id="rv-sent-ok-text"></span>
            </div>
            <div class="rv-blockhead">
              <h2 id="rv-sent-h" class="rv-disp rv-h2">Sent to Scott</h2>
              <span id="rv-sent-count" class="rv-dim"></span>
            </div>
            <p id="rv-sent-empty" class="rv-dim">Nothing sent yet on this version.</p>
            <div id="rv-sent" class="rv-list"></div>
            <p id="rv-sent-other" class="rv-dim rv-small"></p>
            <p class="rv-dim rv-small">Everyone on this review sees these notes. Sent notes go straight to Scott's queue.</p>
          </section>
        </aside>
      </div>
    </div>

    <div id="rv-send-bar" class="rv-sendbar" hidden>
      <span id="rv-send-bar-text"></span>
      <button type="button" id="rv-send-bar-btn" class="rv-btn rv-btn-primary">Send feedback</button>
    </div>

    <dialog id="rv-name-dlg" class="rv-dialog" aria-labelledby="rv-name-h">
      <form id="rv-name-form" method="dialog">
        <h2 id="rv-name-h" class="rv-disp rv-h3">Your name</h2>
        <p class="rv-dim">So Scott knows who each note is from. Everyone on this review sees it.</p>
        <label class="rv-sr" for="rv-name-input">Your name</label>
        <input id="rv-name-input" name="name" type="text" autocomplete="given-name" maxlength="60" required placeholder="e.g. Jay" />
        <div class="rv-c-actions">
          <button type="submit" class="rv-btn rv-btn-primary">Continue</button>
          <button type="button" id="rv-name-later" class="rv-btn rv-btn-ghost">Later</button>
        </div>
      </form>
    </dialog>

    <audio id="rv-audio" preload="metadata" playsinline></audio>
  </div>
</Base>

<script>
  import { initReview } from "../lib/review/app";
  document.addEventListener("astro:page-load", initReview);
</script>
