---
import Base from "../layouts/Base.astro";
import { bookHref } from "../lib/nav";
import { ORG_ID, SITE, SOCIALS as socials } from "../lib/seo";
---
<Base title="Contact Tritone Productions · Book a Studio Day or Band" description="Contact Scott Larson at Tritone Productions, music production in Oakland, CA: book a session at the Hummingbird Hut recording studio or a Bay Area band." breadcrumbs={[{ name: "Contact", path: "/contact" }]} schema={[{ "@type": "ContactPage", "@id": `${SITE}/contact#page`, url: `${SITE}/contact`, name: "Contact Tritone Productions", about: { "@id": ORG_ID } }]}>
  <section class="wrap pb-12 pt-10 md:pb-16 md:pt-16">
    <p class="eyebrow m-0 text-stone">Tritone Productions · Music production · Oakland, CA</p>
    <h1 class="disp mb-0 mt-4 text-[clamp(3.2rem,11vw,8.6rem)] leading-[0.86]">Say <span class="outline-type">hello</span></h1>
    <p class="mb-0 mt-6 max-w-[48ch] text-[19px]">Sessions, gigs, or a question about either. Scott reads everything himself and usually answers within a day.</p>
  </section>

  <!-- Email is the only way in (no phone on the site). The address is sized to its tile with container
       units so it always sits on one line, from a 320px phone to a wide desktop. -->
  <section class="wrap pb-12 md:pb-16" aria-labelledby="email-h">
    <div class="tile reveal flex flex-col gap-8 p-5 md:gap-12 md:p-10">
      <div class="grid gap-4 md:grid-cols-12 md:items-end md:gap-10">
        <div class="flex flex-col gap-3 md:col-span-6">
          <p class="eyebrow m-0 text-stone">Email Scott</p>
          <h2 id="email-h" class="disp m-0 text-[clamp(2.2rem,5.4vw,4rem)] leading-[0.92]">Questions or ideas?</h2>
        </div>
        <p class="m-0 max-w-[42ch] text-[17px] text-white/90 md:col-span-6 md:text-[19px]">To plan a session or a project, email to set up a time to consult. Recording, a band for a date, or just an idea you want to talk through.</p>
      </div>

      <div class="email-fit rule border-t pt-6 md:pt-8">
        <a href="mailto:scott@tritone-productions.com" class="email-line group flex items-center justify-between gap-[0.4em] no-underline">
          <span class="disp whitespace-nowrap normal-case leading-none">scott@tritone-productions.com</span>
          <span class="hidden size-[1.25em] shrink-0 place-items-center md:grid rounded-full bg-white text-[0.7em] text-black transition-transform group-hover:rotate-[-45deg]" aria-hidden="true">→</span>
        </a>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="mailto:scott@tritone-productions.com?subject=Planning%20a%20session" class="flex min-h-12 items-center rounded-full bg-white px-6 text-sm font-semibold uppercase tracking-[.04em] text-black no-underline transition-transform hover:scale-[1.03]">Write an email</a>
          <button type="button" data-copy="scott@tritone-productions.com" class="flex min-h-12 cursor-pointer items-center rounded-full border-2 border-stone/60 px-6 text-sm font-semibold uppercase tracking-[.04em] hover:border-white">Copy address</button>
          <span class="text-[14px] text-stone" data-copied role="status"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap pb-12 md:pb-16" aria-label="Booking">
    <div class="grid gap-4 md:grid-cols-2 md:gap-5">
      <a href={bookHref} class="tile reveal group flex min-h-[240px] flex-col justify-between gap-8 !border-stone !bg-stone p-6 text-black no-underline md:p-8">
        <p class="eyebrow m-0">Recording · Hummingbird Hut</p>
        <div class="flex flex-col gap-3">
          <h2 class="disp m-0 text-[clamp(2.2rem,5vw,3.6rem)] leading-[0.92]">Book the Hut</h2>
          <p class="m-0 max-w-[40ch] text-[16px]">Pick an open day on the studio calendar. The address is sent once your booking is confirmed.</p>
        </div>
      </a>
      <div class="tile reveal flex min-h-[240px] flex-col justify-between gap-8 p-6 md:p-8">
        <p class="eyebrow m-0 text-stone">Live · The bands</p>
        <div class="flex flex-col gap-3">
          <h2 class="disp m-0 text-[clamp(2.2rem,5vw,3.6rem)] leading-[0.92]">Book a band</h2>
          <p class="m-0 max-w-[40ch] text-[16px] text-white/85">Clubs, parties and festivals. Send the date, the place and the kind of night you have in mind.</p>
          <div class="flex flex-wrap gap-x-6 gap-y-2 pt-1">
            <a href="mailto:scott@tritone-productions.com?subject=Band%20booking" class="font-semibold">Email about a date →</a>
            <a href="/bands" class="font-semibold text-stone hover:text-white">Meet the bands →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap pb-20 md:pb-28" aria-labelledby="where-h">
    <div class="rule flex flex-col gap-6 border-t pt-8 md:flex-row md:items-start md:justify-between">
      <div class="flex flex-col gap-1">
        <p class="eyebrow m-0 text-stone" id="where-h">Where</p>
        <p class="m-0 text-[19px] font-semibold">Oakland, CA</p>
        <p class="m-0 text-[15px] text-stone">Studio address sent once your booking is confirmed.</p>
      </div>
      <div class="flex flex-col gap-3">
        <p class="eyebrow m-0 text-stone">Follow along</p>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center rounded-full border-2 border-stone/60 px-5 text-sm font-semibold uppercase tracking-[.04em] no-underline hover:border-white">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The address is ~16.2em wide in lowercase Archivo Black (+1.65em for the arrow from tablet up): size it to the tile
     so it never wraps or overflows, capped on wide screens. */
  .email-fit { container-type: inline-size; }
  .email-line { font-size: calc(100cqi / 16.7); }
  @media (min-width: 768px) { .email-line { font-size: min(calc(100cqi / 18.3), 76px); } }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.querySelector<HTMLButtonElement>("[data-copy]");
    const out = document.querySelector<HTMLElement>("[data-copied]");
    if (!btn || !out || btn.dataset.ready) return;
    btn.dataset.ready = "1";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        out.textContent = "Copied. Paste it into your email.";
      } catch {
        out.textContent = btn.dataset.copy!;
      }
    });
  });
</script>
