---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Pill from "../components/Pill.astro";
---
<Base title="Book the Hut · Tritone Productions · Oakland, CA" description="Tell Scott about your project: the group, the dates you have in mind, and what you want to come away with. The studio address is sent once a booking is confirmed.">
  <PageHead eyebrow="Hummingbird Hut · Oakland, CA" title="Book the Hut">
    <p class="m-0 max-w-[60ch] text-[19px]">Tell Scott about your project: the group, the dates you have in mind, and what you want to come away with. The studio address is sent once a booking is confirmed.</p>
    <div class="pt-2"><Pill href="mailto:scott@tritone-productions.com?subject=Hummingbird%20Hut%20booking">Email to book</Pill></div>
  </PageHead>
</Base>
