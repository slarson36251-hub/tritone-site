---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Pill from "../components/Pill.astro";
import { posters } from "../lib/posters";

const bandNames = Object.fromEntries((await getCollection("bands")).map((b) => [b.id, b.data.name]));
// Large versions for the lightbox, made at build time.
const items = await Promise.all(
  posters.map(async (p) => {
    const full = await getImage({ src: p.img, width: Math.min(p.img.width, 1400), format: "webp" });
    return { ...p, full: full.src };
  }),
);
---
<Base title="Gig Poster Gallery · Tritone Productions Bands" description="Gig posters for Tritone Productions bands at Club Deluxe, the Rite Spot, the Uptown in Oakland and more: Hard Bop Quintet, Franco Nero, Scott Larson Quartet." breadcrumbs={[{ name: "Gallery", path: "/gallery" }]}>
  <PageHead eyebrow="Tritone Productions" title="Gallery">
    <p class="m-0 max-w-[60ch] text-[19px]">Gig posters from the Tritone bands, from Club Deluxe to the Uptown. Tap one to see it big.</p>
    <div class="pt-2"><Pill href="/bands" ghost>The bands</Pill></div>
  </PageHead>

  <section class="wrap pb-16 md:pb-24" aria-label="Posters">
    <ul class="m-0 list-none columns-2 gap-3 p-0 md:columns-3 md:gap-5 lg:columns-4">
      {items.map((p, i) => (
        <li id={p.id} class="reveal mb-3 break-inside-avoid md:mb-5">
          <button type="button" class="g-open group block w-full cursor-zoom-in text-left" data-index={i} aria-label={`Open poster: ${p.title}`}>
            <span class="tile block" style={`aspect-ratio:${p.img.width} / ${p.img.height}`}>
              <Image src={p.img} alt={p.alt} widths={[240, 400, 640]} sizes="(min-width: 1024px) 23vw, (min-width: 761px) 30vw, 46vw" class="tile-img absolute inset-0 h-full w-full object-cover group-hover:scale-[1.03]" />
            </span>
            <span class="mt-2 block text-sm font-semibold leading-tight md:text-[15px]">{p.title}</span>
            <span class="mt-0.5 block text-[14px] text-stone md:text-sm">{p.sub}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <dialog id="lightbox" class="lb m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-transparent p-0 text-white" aria-label="Poster viewer">
    <div id="lb-wrap" class="flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 px-4 pt-[max(12px,env(safe-area-inset-top))] md:px-8">
        <p class="eyebrow m-0 text-stone"><span id="lb-count"></span></p>
        <button type="button" id="lb-close" class="grid size-12 cursor-pointer place-items-center rounded-full bg-white text-black" aria-label="Close">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2.2"/></svg>
        </button>
      </div>
      <figure class="relative m-0 flex min-h-0 flex-1 items-center justify-center px-4 py-4 md:px-24">
        <img id="lb-img" class="lb-img max-h-full max-w-full rounded-[12px] object-contain shadow-[0_24px_80px_rgb(0_0_0/.6)]" alt="" decoding="async" />
        <button type="button" id="lb-prev" class="lb-nav left-3 md:left-8" aria-label="Previous poster">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 2L4 9l7 7" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
        </button>
        <button type="button" id="lb-next" class="lb-nav right-3 md:right-8" aria-label="Next poster">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 2l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
        </button>
      </figure>
      <figcaption class="px-4 pb-[max(20px,env(safe-area-inset-bottom))] text-center md:px-8">
        <p id="lb-title" class="disp m-0 text-xl leading-tight md:text-2xl"></p>
        <p id="lb-sub" class="m-0 mt-1 text-sm text-stone"></p>
        <p id="lb-band" class="m-0 mt-2 text-sm"></p>
      </figcaption>
    </div>
  </dialog>

  <script is:inline type="application/json" id="lb-data" set:html={JSON.stringify(items.map((p) => ({
    id: p.id, src: p.full, alt: p.alt, title: p.title, sub: p.sub,
    bands: p.bands.map((b) => ({ href: `/bands/${b}`, name: bandNames[b] ?? b })),
  })))} />
</Base>

<style>
  .lb::backdrop { background: rgb(0 0 0 / 0.92); backdrop-filter: blur(8px); }
  .lb[open] { animation: lb-in 0.28s var(--ease-out-quint); }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.98); } }
  .lb-img { touch-action: pan-y; user-select: none; -webkit-user-drag: none; transition: opacity .2s; }
  .lb-nav {
    position: absolute; top: 50%; translate: 0 -50%;
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 9999px; cursor: pointer;
    background: rgb(0 0 0 / 0.55); border: 1px solid rgb(168 166 161 / 0.5); color: var(--color-white);
    backdrop-filter: blur(6px); transition: background .2s, color .2s;
  }
  .lb-nav:hover { background: var(--color-white); color: var(--color-black); }
  #lb-band :global(a) { font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .lb[open] { animation: none; } }
</style>

<script>
  type Item = { id: string; src: string; alt: string; title: string; sub: string; bands: { href: string; name: string }[] };

  function init() {
    const dlg = document.getElementById("lightbox") as HTMLDialogElement | null;
    if (!dlg || dlg.dataset.ready) return;
    dlg.dataset.ready = "1";
    const items: Item[] = JSON.parse(document.getElementById("lb-data")!.textContent || "[]");
    const img = document.getElementById("lb-img") as HTMLImageElement;
    const $ = (id: string) => document.getElementById(id)!;
    let i = 0;
    let opener: HTMLElement | null = null;

    const show = (n: number) => {
      i = (n + items.length) % items.length;
      const it = items[i];
      img.src = it.src;
      img.alt = it.alt;
      $("lb-title").textContent = it.title;
      $("lb-sub").textContent = it.sub;
      $("lb-count").textContent = `${i + 1} / ${items.length}`;
      const band = $("lb-band");
      band.replaceChildren(...it.bands.map((b, k) => {
        const a = document.createElement("a");
        a.href = b.href;
        a.textContent = `${b.name} →`;
        if (k) a.style.marginLeft = "1em";
        return a;
      }));
      history.replaceState(history.state, "", `#${it.id}`);
      // Warm the neighbours so arrows feel instant.
      [i + 1, i - 1].forEach((k) => { const p = items[(k + items.length) % items.length]; new Image().src = p.src; });
    };
    const open = (n: number, from?: HTMLElement) => {
      opener = from ?? null;
      show(n);
      dlg.showModal();
      ($("lb-close") as HTMLButtonElement).focus();
    };
    const close = () => dlg.close();

    document.querySelectorAll<HTMLButtonElement>(".g-open").forEach((b) =>
      b.addEventListener("click", () => open(Number(b.dataset.index), b)),
    );
    $("lb-close").addEventListener("click", close);
    $("lb-prev").addEventListener("click", () => show(i - 1));
    $("lb-next").addEventListener("click", () => show(i + 1));
    dlg.addEventListener("close", () => {
      history.replaceState(history.state, "", location.pathname);
      opener?.focus();
    });
    // Clicking the dark area (not the image or controls) closes.
    dlg.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.id === "lb-wrap" || t.tagName === "FIGURE") close();
    });
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); show(i + 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); show(i - 1); }
    });

    // Swipe left/right to move, swipe down to close.
    let x0 = 0, y0 = 0, tracking = false;
    dlg.addEventListener("pointerdown", (e) => { if (e.pointerType !== "mouse") { x0 = e.clientX; y0 = e.clientY; tracking = true; } });
    dlg.addEventListener("pointerup", (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(i + (dx < 0 ? 1 : -1));
      else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) close();
    });
    dlg.addEventListener("pointercancel", () => (tracking = false));

    // Deep link: /gallery#<poster-id> opens that poster.
    const hash = decodeURIComponent(location.hash.slice(1));
    const at = items.findIndex((it) => it.id === hash);
    if (at >= 0) open(at, document.querySelector<HTMLElement>(`.g-open[data-index="${at}"]`) ?? undefined);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
