---
// The session log: a shelf of tape boxes (newest left) and the open session's panel below.
// Deep links /sessions#<id> open that panel; every session also has its own page /sessions/<id>.
// To add a session, add src/content/sessions/<id>.md (see src/content.config.ts for the fields).
import Base from "../layouts/Base.astro";
import Shelf from "../components/sessions/Shelf.astro";
import SessionDetail from "../components/sessions/SessionDetail.astro";
import { getSessions } from "../lib/sessions";

const sessions = await getSessions();
const first = sessions[0].id;
---
<Base title="Sessions · Hummingbird Hut · Tritone Productions · Oakland, CA" description="Sessions recorded at the Hummingbird Hut, a private recording studio in Oakland, CA: who played, the hours, the mics, photos and videos.">
  <div id="sessions-index">
    <section class="bg-black pb-2 pt-8 md:pt-12" aria-labelledby="shelf-h">
      <div class="wrap">
        <Shelf sessions={sessions} tabs selected={first} morph priority drift label="Sessions, most recent first">
          <div class="flex flex-col gap-2">
            <p class="eyebrow m-0 text-stone">The tape shelf · Hummingbird Hut · Oakland, CA</p>
            <h1 id="shelf-h" class="disp m-0 text-[clamp(2.2rem,6vw,3.6rem)] leading-[0.95]">Sessions</h1>
            <p class="m-0 max-w-[62ch] text-[17px] text-white/85">How we work at the Hut: the band plays together in one room, each player on their own mic, with Dante lines and headphone mixes into other rooms and overdubs when a session needs them. Each box below is a real session, with who played, the hours, the mics and preamps we used, photos and video.</p>
            <p class="m-0 max-w-[62ch] text-[15px] text-white/75">Want to hear it from a musician? Ask, and we'll put you in touch with past clients who are happy to vouch for the Hut.</p>
            <p class="m-0 text-stone">Pick a box to open the session. Most recent first.</p>
          </div>
        </Shelf>
      </div>
      <div class="h-6 md:h-8"></div>
    </section>

    <div class="wrap pb-16 pt-10 md:pb-24 md:pt-14" id="session-panels">
      {sessions.map((s) => (
        <section id={`p-${s.id}`} role="tabpanel" aria-labelledby={`t-${s.id}`} tabindex="-1" class="session-panel outline-none" hidden={s.id !== first}>
          <SessionDetail session={s} level={2} eager={s.id === first} pageLink />
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .session-panel:not([hidden]) { animation: panel-in 0.3s var(--ease-out-quint); }
  }
  @keyframes panel-in { from { opacity: 0.4; transform: translateY(8px); } }
</style>

<script>
  let show: ((id: string, how?: "user" | "key" | "load") => void) | undefined;

  function init() {
    const root = document.getElementById("sessions-index");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const row = root.querySelector<HTMLElement>("[data-tapes]")!;
    const ids = tabs.map((t) => t.dataset.session!);

    show = (want, how = "load") => {
      const id = ids.includes(want) ? want : ids[0];
      tabs.forEach((t) => {
        const on = t.dataset.session === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => (p.hidden = p.id !== `p-${id}`));
      // Bring the chosen tape into view on the shelf without moving the page.
      const tape = tabs[ids.indexOf(id)];
      const left = tape.offsetLeft - row.offsetLeft;
      if (left < row.scrollLeft || left + tape.offsetWidth > row.scrollLeft + row.clientWidth)
        row.scrollTo({ left: Math.max(0, left - 2), behavior: how === "load" ? "instant" : "smooth" });
      if (how !== "load") {
        history.replaceState(history.state, "", `#${id}`);
        if (how === "user") {
          // Scroll to the panel only if its top is not already comfortably on screen.
          const panel = document.getElementById(`p-${id}`)!;
          const top = panel.getBoundingClientRect().top;
          if (top < 0 || top > innerHeight * 0.55) {
            const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
            panel.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
          }
        }
      }
    };

    tabs.forEach((t) =>
      t.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        show!(t.dataset.session!, "user");
      }),
    );
    // Arrow keys move along the shelf (tabs pattern); Enter/Space open the panel.
    row.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      let n = -1;
      if (e.key === "ArrowRight") n = (i + 1) % tabs.length;
      else if (e.key === "ArrowLeft") n = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === "Home") n = 0;
      else if (e.key === "End") n = tabs.length - 1;
      else if (e.key === " ") { e.preventDefault(); show!(ids[i], "user"); return; }
      if (n < 0) return;
      e.preventDefault();
      tabs[n].focus();
      show!(ids[n], "key");
    });

    show(decodeURIComponent(location.hash.slice(1)), "load");
  }

  // Someone edits the hash, or follows a #link on this page.
  addEventListener("hashchange", () => {
    if (document.getElementById("sessions-index")) show?.(decodeURIComponent(location.hash.slice(1)), "load");
  });
  init();
  document.addEventListener("astro:page-load", init);
</script>
