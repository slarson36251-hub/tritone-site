---
// Promo kit for the Woodchopper's Ball team: bio, credit, links, captions and the poster
// and Instagram files, ready to download. Linked from the email to the promoter.
import Base from "../../layouts/Base.astro";
import Pill from "../../components/Pill.astro";

const DIR = "/press/lucky-7-dec-15";
const B = "scotch-larson-lucky-7-verdi-club-san-francisco-dec-15-2026";
const files = [
  { label: "Poster", note: "1650 × 2550 JPG, for web and email", href: `${DIR}/${B}-poster.jpg`, img: `${DIR}/${B}-poster.jpg` },
  { label: "Poster, print", note: "11 × 17 at 300 dpi, JPG", href: `${DIR}/${B}-poster-print-11x17.jpg`, img: `${DIR}/${B}-poster.jpg` },
  { label: "Instagram post", note: "1080 × 1350 JPG (4:5)", href: `${DIR}/${B}-instagram-feed-1080x1350.jpg`, img: `${DIR}/${B}-instagram-feed-1080x1350.jpg` },
  { label: "Instagram post, animated", note: "1080 × 1350 MP4 with music, 13 s", href: `${DIR}/${B}-instagram-feed-animated.mp4`, img: `${DIR}/${B}-instagram-feed-1080x1350.jpg` },
  { label: "Instagram story", note: "1080 × 1920 JPG (9:16)", href: `${DIR}/${B}-instagram-story-1080x1920.jpg`, img: `${DIR}/${B}-instagram-story-1080x1920.jpg` },
  { label: "Instagram story, animated", note: "1080 × 1920 MP4 with music, 13 s", href: `${DIR}/${B}-instagram-story-animated.mp4`, img: `${DIR}/${B}-instagram-story-1080x1920.jpg` },
];
const bio =
  "Lucky 7 plays the hot jazz of New Orleans and the dance music of the 1920s, ’30s and ’40s. Trombonist Scott Larson started the band twenty-five years ago, and it has worked Bay Area rooms ever since, from the Amnesia of yesteryear and the Make-Out Room to happy hours at The Chapel and Sunday sets at Drake’s Dealership in Oakland. It is live music for dancers: four horns up front, guitar, bass and drums underneath, playing originals alongside favorite covers from Duke Ellington to Cab Calloway. On December 15 vocalist Allegra Bandy joins the band at the Woodchopper’s Ball. Twenty-five years later, we come out to play.";
const captions = [
  "Tuesday, Dec 15 at the Woodchopper’s Ball: Scotch Larson presents his Lucky 7, featuring @allegrabandy. Hot jazz and swing for dancers, originals and favorites from Ellington to Cab Calloway. Drop-in swing lesson at 9, band sets at 9:15 and 10:30. $20 at the door, $10 students, cash only. Twenty-five years later, we come out to play. @verdiclubsf @tritone_productions @henryhungmusic @patrick.wolff.music",
  "Lucky 7 is back. Four horns, guitar, bass, drums and @allegrabandy on vocals for the Woodchopper’s Ball at @verdiclubsf, Tuesday Dec 15. Lesson at 9, sets at 9:15 and 10:30. With @henryhungmusic, @patrick.wolff.music and friends. #swingdance #lindyhop #sfswing #hotjazz #sanfrancisco",
];
const lineup = [
  ["Scott Larson", "trombone, leader"],
  ["Henry Hung", "trumpet"],
  ["James Dunning", "trumpet"],
  ["Patrick Wolff", "clarinet, tenor sax"],
  ["Myles Boisen", "guitar"],
  ["Safa Shokrai", "bass"],
  ["Benny Amon", "drums"],
  ["Allegra Bandy", "vocals"],
];
const links = [
  ["Show page (music and animated poster)", "https://tritone-productions.com/lucky-7-woodchoppers-ball"],
  ["Lucky 7, nine tracks to hear", "https://tritone-productions.com/bands/lucky-7"],
  ["Instagram", "https://www.instagram.com/tritone_productions/"],
  ["Facebook", "https://www.facebook.com/tritoneproductions"],
  ["Tritone Productions", "https://tritone-productions.com/"],
];
---
<Base title="Lucky 7 promo kit · Woodchopper's Ball · Dec 15 · Tritone Productions" description="Poster, Instagram post and story files, band bio, lineup, captions and links for Lucky 7 at the Woodchopper's Ball, Verdi Club, Tuesday, December 15, 2026." noindex>
  <article class="wrap flex flex-col gap-12 pb-20 pt-8 md:pt-12">
    <header class="flex flex-col gap-3">
      <p class="eyebrow m-0 text-white/80">Promo kit · Tuesday, December 15, 2026</p>
      <h1 class="disp m-0 text-[clamp(1.9rem,8vw,4.5rem)] leading-[.95] [overflow-wrap:anywhere]">Lucky 7 at the Woodchopper’s Ball</h1>
      <p class="m-0 text-[19px]">Scotch Larson presents his Lucky 7, featuring Allegra Bandy. Verdi Club, San Francisco. Drop-in swing lesson at 9:00, band sets at 9:15 and 10:30 PM. $20 at the door, $10 students, cash only.</p>
      <p class="m-0 text-[17px] text-white/80">Everything here is free to post. Credit: illustration and design by Tritone Productions.</p>
    </header>

    <section aria-labelledby="dl-h">
      <h2 id="dl-h" class="eyebrow m-0 mb-4 text-white/80">Poster and Instagram files</h2>
      <ul class="m-0 grid list-none grid-cols-2 gap-4 p-0 md:grid-cols-3 lg:grid-cols-6">
        {files.map((f) => (
          <li class="flex flex-col gap-2">
            <a href={f.href} download class="block overflow-hidden rounded-md border border-stone/40 no-underline hover:border-white">
              <img src={f.img} alt={`${f.label}: Lucky 7 poster in orange and navy`} loading="lazy" decoding="async" class="block aspect-[11/17] w-full object-cover" />
            </a>
            <a href={f.href} download class="inline-flex min-h-11 items-center font-semibold">{f.label} ↓</a>
            <span class="text-[14px] text-white/80">{f.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="grid gap-10 md:grid-cols-2">
      <section aria-labelledby="bio-h" class="flex flex-col gap-3">
        <h2 id="bio-h" class="eyebrow m-0 text-white/80">Short bio</h2>
        <p class="m-0 text-[17px]">{bio}</p>
      </section>

      <section aria-labelledby="lu-h">
        <h2 id="lu-h" class="eyebrow m-0 mb-3 text-white/80">Lineup</h2>
        <ul class="m-0 flex list-none flex-col p-0">
          {lineup.map(([n, r]) => (
            <li class="rule flex justify-between gap-4 border-b py-2.5"><span class="font-semibold">{n}</span><span class="text-white/80">{r}</span></li>
          ))}
        </ul>
      </section>
    </div>

    <section aria-labelledby="cap-h" class="flex flex-col gap-4">
      <h2 id="cap-h" class="eyebrow m-0 text-white/80">Captions to copy</h2>
      <p class="m-0 text-[15px] text-white/80">Instagram tags: @tritone_productions, @verdiclubsf, @allegrabandy, @henryhungmusic, @patrick.wolff.music.</p>
      {captions.map((c) => (
        <p class="m-0 rounded-md border border-stone/40 bg-black/20 p-5 text-[17px]">{c}</p>
      ))}
    </section>

    <section aria-labelledby="ln-h">
      <h2 id="ln-h" class="eyebrow m-0 mb-3 text-white/80">Links</h2>
      <ul class="m-0 flex list-none flex-col p-0">
        {links.map(([l, u]) => (
          <li class="rule border-b py-2.5"><a href={u} class="inline-flex min-h-11 items-center font-semibold [overflow-wrap:anywhere]">{l} →</a></li>
        ))}
      </ul>
    </section>

    <div class="flex flex-wrap gap-3">
      <Pill href="/lucky-7-woodchoppers-ball">See the show page</Pill>
      <Pill href="mailto:scott@tritone-productions.com" ghost>Email Scott</Pill>
    </div>
  </article>
</Base>
