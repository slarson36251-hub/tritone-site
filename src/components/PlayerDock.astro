---
import { featuredPlaylist } from "../lib/player";
---
<!--
  Persistent player. transition:persist keeps this element (and the Spotify iframe inside it)
  alive across page navigations, so music never stops while someone browses.
  The iframe is only created on first play, so it costs nothing until then.
-->
<div id="dock" transition:persist="player-dock" class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center px-3 pb-[max(12px,env(safe-area-inset-bottom))]">
  <div class="pointer-events-auto w-full max-w-[520px] overflow-hidden rounded-[22px] border border-stone/35 bg-black/85 shadow-[0_18px_50px_rgb(0_0_0/.45)] backdrop-blur-xl">
    <div class="flex items-center gap-3 p-2 pl-2">
      <button id="dock-toggle" type="button" aria-expanded="false" aria-controls="dock-frame"
        class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-full bg-white text-black transition-transform hover:scale-105"
        data-embed={featuredPlaylist.embed}>
        <svg class="dock-play ml-0.5" width="16" height="18" viewBox="0 0 16 18" aria-hidden="true"><path d="M0 0l16 9-16 9z" fill="currentColor"/></svg>
        <svg class="dock-close hidden" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2.2"/></svg>
        <span class="sr-only">Listen</span>
      </button>
      <div class="min-w-0 flex-1 leading-tight">
        <p class="eyebrow m-0 text-[11px] text-stone">Now playing from the Hut</p>
        <p id="dock-title" class="m-0 truncate font-semibold">{featuredPlaylist.label} · <span class="font-normal text-stone">{featuredPlaylist.sub}</span></p>
      </div>
      <span class="dock-eq mr-3 hidden items-end gap-[3px]" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </div>
    <div id="dock-frame" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out-quint">
      <div class="overflow-hidden"><div id="dock-slot" class="px-2 pb-2"></div></div>
    </div>
  </div>
</div>

<style>
  #dock.open #dock-frame { grid-template-rows: 1fr; }
  #dock.open .dock-play { display: none; }
  #dock.open .dock-close { display: block; }
  #dock.started .dock-eq { display: flex; }
  .dock-eq i { display: block; width: 3px; height: 14px; background: var(--color-stone); border-radius: 2px; transform-origin: bottom; animation: eq 1s ease-in-out infinite; }
  .dock-eq i:nth-child(2) { animation-delay: -0.4s; }
  .dock-eq i:nth-child(3) { animation-delay: -0.7s; }
  .dock-eq i:nth-child(4) { animation-delay: -0.2s; }
  @keyframes eq { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .dock-eq i { animation: none; } }
</style>

<script>
  function setup() {
    const dock = document.getElementById("dock")!;
    if (dock.dataset.ready) return; // persisted across navigations: wire up once
    dock.dataset.ready = "1";
    const btn = document.getElementById("dock-toggle") as HTMLButtonElement;
    const slot = document.getElementById("dock-slot")!;

    const load = (src: string) => {
      slot.innerHTML = `<iframe title="Spotify player" src="${src}" width="100%" height="152" style="border:0;border-radius:14px;display:block" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>`;
      dock.classList.add("started");
    };
    const open = (yes: boolean) => {
      dock.classList.toggle("open", yes);
      btn.setAttribute("aria-expanded", String(yes));
    };

    btn.addEventListener("click", () => {
      if (!slot.firstChild) load(btn.dataset.embed!);
      open(!dock.classList.contains("open"));
    });

    // Any element with data-play="<spotify embed url>" (and optional data-play-title) plays in the dock.
    document.addEventListener("click", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-play]");
      if (!el) return;
      e.preventDefault();
      load(el.dataset.play!);
      if (el.dataset.playTitle) document.getElementById("dock-title")!.textContent = el.dataset.playTitle;
      open(true);
    });
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>
