---
// Everything about one session: name, intro, cover, session log, people, gear notes, videos, photos.
// Used for the panels on /sessions (level 2, link to the page) and for /sessions/<id> (level 1, hero morph).
import { Picture, getImage } from "astro:assets";
import { render } from "astro:content";
import LiteYouTube from "./LiteYouTube.astro";
import Bandcamp from "./Bandcamp.astro";
import { coverTransition, type Session } from "../../lib/sessions";

interface Props {
  session: Session;
  level?: 1 | 2;
  /** Load the cover now (it is above the fold). */
  eager?: boolean;
  /** Give the cover the view-transition name the shelf tape carries. */
  morph?: boolean;
  /** Show the "Open session page" link (panels on /sessions). */
  pageLink?: boolean;
}
const { session, level = 2, eager = false, morph = false, pageLink = false } = Astro.props;
const { id } = session;
const d = session.data;
const { Content } = await render(session);
const [cover, ...rest] = d.photos;
const H = level === 1 ? "h1" : "h2";
const Sub = level === 1 ? "h2" : "h3";
const lead = (p: { date?: string; label?: string }) => p.date ?? p.label;
// Full, uncropped versions for the photo viewer (the grid crops to 4:3).
const full = await Promise.all(rest.map((p) => getImage({ src: p.src, width: 1600, format: "webp" })));
---
<div class="flex flex-col gap-10 md:gap-14">
  <div class="flex max-w-[820px] flex-col gap-3">
    <p class="eyebrow m-0 text-stone">Hummingbird Hut · Oakland, CA · {d.when}</p>
    <H class="disp m-0 text-[clamp(2.4rem,7vw,4.6rem)] leading-[0.92]">{d.artist}</H>
    <div class="lede max-w-[62ch] text-[18px] text-white/85 md:text-[19px]"><Content /></div>
    {d.links.length > 0 && (
      <p class="m-0 flex flex-wrap items-center gap-x-4 gap-y-1 pt-1 text-[15px]">
        <span class="text-stone">Follow {d.artist}:</span>
        {d.links.map((l) => <a href={l.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center font-semibold underline-offset-4 hover:underline">{l.label} <span aria-hidden="true" class="ml-1 text-stone">↗</span></a>)}
      </p>
    )}
    {pageLink && (
      <p class="m-0 pt-1"><a href={`/sessions/${id}`} class="inline-flex min-h-11 items-center gap-2 font-semibold underline-offset-4 hover:underline">Open session page <span aria-hidden="true">→</span></a></p>
    )}
  </div>

  <div class="grid items-start gap-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10">
    <figure class="m-0 flex flex-col gap-2.5">
      <span class="tile block !rounded-[10px]" style={morph ? `view-transition-name:${coverTransition(id)}` : undefined}>
        <Picture
          src={cover.src}
          alt={cover.alt}
          formats={["avif"]}
      fallbackFormat="webp"
          widths={[400, 600, 800, 1200]}
          sizes="(min-width: 1280px) 500px, (min-width: 761px) 40vw, calc(100vw - 32px)"
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : undefined}
          class="block h-auto w-full"
        />
      </span>
      <figcaption class="text-[14px] text-stone">{lead(cover) && <b class="font-semibold text-white">{lead(cover)}.</b>} {cover.caption}</figcaption>
    </figure>

    <div class="flex min-w-0 flex-col gap-8">
      {d.sessions.length > 0 && (
        <div>
          <Sub class="eyebrow mb-3 mt-0 text-stone">Sessions</Sub>
          <dl class="sheet m-0">
            {d.sessions.map((s) => (
              <>
                <dt>{s.date}</dt>
                <dd>{[s.what, s.hours].filter(Boolean).join(", ")}{s.gear && <>{s.what || s.hours ? ". " : ""}<span class="text-white/80">{s.gear}</span></>}</dd>
              </>
            ))}
          </dl>
        </div>
      )}
      {d.people.length > 0 && (
        <div>
          <Sub class="eyebrow mb-3 mt-0 text-stone">{d.peopleHeading}</Sub>
          <ul class="people m-0 list-none p-0">
            {d.people.map((p) => <li><b>{p.name}</b><span>{p.role}</span></li>)}
          </ul>
        </div>
      )}
      {d.notes.map((n) => (
        <div>
          <Sub class="eyebrow mb-3 mt-0 text-stone">{n.heading}</Sub>
          <dl class="sheet m-0">
            {n.rows.map((r) => <><dt>{r.label}</dt><dd>{r.value}</dd></>)}
          </dl>
        </div>
      ))}
    </div>
  </div>

  {d.albums.length > 0 && (
    <div>
      <Sub class="eyebrow mb-4 mt-0 text-stone">Listen · the record</Sub>
      <div class="flex flex-col gap-8">
        {d.albums.map((a) => <Bandcamp {...a} />)}
      </div>
    </div>
  )}

  {d.videos.length > 0 && (
    <div>
      <Sub class="eyebrow mb-4 mt-0 text-stone">{d.videosHeading}</Sub>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {d.videos.map((v) => <LiteYouTube id={v.youtubeId} title={v.title} alt={v.alt} note={v.note} />)}
      </div>
    </div>
  )}

  {rest.length > 0 && (
    <div>
      <Sub class="eyebrow mb-4 mt-0 text-stone">{d.photosHeading}</Sub>
      <div class="grid grid-cols-2 gap-x-3 gap-y-5 md:grid-cols-3 md:gap-x-5 lg:grid-cols-4">
        {rest.map((p, i) => (
          <figure class="m-0 flex flex-col gap-2">
            <button type="button" class="tile group/zoom relative block w-full cursor-zoom-in !rounded-[10px] border-0 p-0 text-left" data-zoom={full[i].src} data-zoom-alt={p.alt} data-zoom-caption={[lead(p), p.caption].filter(Boolean).join(". ")} aria-label={`View full photo: ${p.alt}`}>
              <Picture
                src={p.src}
                alt={p.alt}
                formats={["avif"]}
      fallbackFormat="webp"
                widths={[240, 360, 480, 720]}
                sizes="(min-width: 1024px) 290px, (min-width: 761px) 30vw, calc(50vw - 22px)"
                loading="lazy"
                class="tile-img block aspect-[4/3] h-auto w-full object-cover"
              />
              <span class="pointer-events-none absolute right-2 top-2 grid size-8 place-items-center rounded-full bg-black/70 text-sm opacity-80 transition-opacity group-hover/zoom:opacity-100" aria-hidden="true">⤢</span>
            </button>
            <figcaption class="text-[14px] leading-snug text-stone">{lead(p) && <b class="font-semibold text-white">{lead(p)}.</b>} {p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .lede :global(p) { margin: 0; }
  .lede :global(p + p) { margin-top: 0.8em; }
  .sheet {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    border-top: 1px solid rgb(168 166 161 / 0.35);
  }
  .sheet dt, .sheet dd { margin: 0; padding: 11px 0; border-bottom: 1px solid rgb(168 166 161 / 0.35); }
  .sheet dt { padding-right: 20px; color: var(--color-stone); font-size: 14px; padding-top: 13px; font-variant-numeric: tabular-nums; }
  .sheet dd { font-size: 16px; font-variant-numeric: tabular-nums; }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    column-gap: 24px;
    border-top: 1px solid rgb(168 166 161 / 0.35);
  }
  .people li { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px solid rgb(168 166 161 / 0.35); }
  .people b { font-weight: 600; }
  .people span { color: var(--color-stone); text-align: right; }
  @media (max-width: 420px) {
    .sheet { grid-template-columns: minmax(0, 1fr); }
    .sheet dt { padding-bottom: 0; border-bottom: 0; }
    .sheet dd { padding-top: 2px; }
  }
</style>

<script>
  // Photo viewer: tap a session photo to see it whole, uncropped. One dialog for the page.
  function viewer() {
    let d = document.getElementById("photo-viewer") as HTMLDialogElement | null;
    if (d) return d;
    d = document.createElement("dialog");
    d.id = "photo-viewer";
    d.className = "photo-viewer";
    d.innerHTML = '<figure><img alt=""><figcaption></figcaption></figure><button type="button" class="pv-close" aria-label="Close photo">✕</button>';
    d.addEventListener("click", (e) => { if (e.target === d || (e.target as HTMLElement).closest(".pv-close")) d!.close(); });
    document.body.append(d);
    return d;
  }
  document.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-zoom]");
    if (!b) return;
    const d = viewer();
    const img = d.querySelector("img")!;
    img.src = b.dataset.zoom!;
    img.alt = b.dataset.zoomAlt ?? "";
    d.querySelector("figcaption")!.textContent = b.dataset.zoomCaption ?? "";
    d.showModal();
  });
  document.addEventListener("astro:before-swap", () => document.getElementById("photo-viewer")?.remove());
</script>
