---
// A Bandcamp album player (bandcamp.com/EmbeddedPlayer), sized to its track list, with a link to the album page.
interface Props {
  bandcampId: string;
  title: string;
  artist: string;
  url: string;
  tracks: number;
  note?: string;
}
const { bandcampId, title, artist, url, tracks, note } = Astro.props;
const src = `https://bandcamp.com/EmbeddedPlayer/album=${bandcampId}/size=large/bgcol=333333/linkcol=ffffff/tracklist=true/artwork=small/transparent=true/`;
// Header with small artwork, then one row per track, then the footer.
const height = 120 + tracks * 33 + 30;
---
<figure class="m-0 flex flex-col gap-2.5">
  <iframe
    src={src}
    title={`${title} by ${artist} on Bandcamp`}
    loading="lazy"
    seamless
    class="block w-full rounded-xl border border-stone/25 bg-charcoal"
    style={`height:${height}px`}
  ></iframe>
  <figcaption class="text-[14px] leading-snug text-stone">
    <b class="font-semibold text-white">{title}</b>{` by ${artist}`}{note ? `. ${note}` : ""}{" · "}<a href={url} target="_blank" rel="noopener" class="text-stone hover:text-white">Bandcamp ↗</a>
  </figcaption>
</figure>
