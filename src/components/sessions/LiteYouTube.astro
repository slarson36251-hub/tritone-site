---
// A YouTube video as a thumbnail link; the player (youtube-nocookie) loads only when clicked.
// Without JavaScript, or with a modifier key, it is a plain link to YouTube.
interface Props {
  id: string;
  title: string;
  alt: string;
  note?: string;
}
const { id, title, alt, note } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}`;
---
<figure class="m-0 flex flex-col gap-2.5">
  <a class="yt group relative block aspect-video overflow-hidden rounded-xl border border-stone/25 bg-black" href={watch} data-yt={id} data-yt-title={title} target="_blank" rel="noopener" aria-label={`Play ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={alt} width="480" height="360" loading="lazy" decoding="async" class="tile-img absolute inset-0 h-full w-full object-cover group-hover:scale-[1.03]" />
    <span class="absolute inset-0 bg-gradient-to-t from-black/50 to-black/0" aria-hidden="true"></span>
    <span class="absolute left-1/2 top-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-charcoal shadow-[0_4px_18px_rgb(0_0_0/.35)] transition-transform group-hover:scale-110 group-focus-visible:scale-110" aria-hidden="true">
      <svg width="16" height="18" viewBox="0 0 16 18" class="ml-1"><path d="M0 0l16 9-16 9z" fill="currentColor" /></svg>
    </span>
  </a>
  <figcaption class="text-[14px] leading-snug text-stone">
    <b class="font-semibold text-white">{title}</b>{note ? ` ${note}` : ""}{" · "}<a href={watch} target="_blank" rel="noopener" class="text-stone hover:text-white">YouTube ↗</a>
  </figcaption>
</figure>

<script>
  // One delegated listener for every video on every page (survives ClientRouter swaps).
  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>("a.yt[data-yt]");
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    const f = document.createElement("iframe");
    f.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(a.dataset.yt!)}?autoplay=1&rel=0`;
    f.title = a.dataset.ytTitle || "YouTube video";
    f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    f.allowFullscreen = true;
    f.className = "absolute inset-0 h-full w-full border-0";
    const box = document.createElement("div");
    box.className = a.className.replace(/\bgroup\b/, "");
    box.appendChild(f);
    a.replaceWith(box);
    f.focus();
  });
</script>
