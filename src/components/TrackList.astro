---
// Audio track list. One <audio> element per list, one track at a time across the page.
// Durations appear once a track's metadata has loaded (preload="none" keeps the page light).
// With a cover, the list sits beside a "deck": the cover as a record sleeve, a disc that slides
// out and spins while a track plays, the current title and one big play/pause button.
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  tracks: { title: string; src: string; credit?: string }[];
  artist: string;
  cover?: ImageMetadata;
  coverAlt?: string;
}
const { tracks, artist, cover, coverAlt } = Astro.props;
---
<div class:list={["tracklist", cover && "tl-has-deck"]} data-tracklist data-artist={artist}>
  <audio preload="none"></audio>
  {cover && (
    <div class="tl-deck">
      <div class="tl-sleeve">
        <span class="tl-disc" aria-hidden="true"><span class="tl-label"></span></span>
        <Picture formats={["avif"]} fallbackFormat="webp" src={cover} alt={coverAlt ?? artist} widths={[200, 320, 480, 600]} sizes="(min-width: 1024px) 280px, (min-width: 761px) 230px, 28vw" class="tl-cover" />
      </div>
      <div class="tl-now">
        <button type="button" class="tl-big" aria-label={`Play ${tracks[0].title}`}>
          <svg class="tl-play ml-1" width="18" height="20" viewBox="0 0 16 18" aria-hidden="true"><path d="M0 0l16 9-16 9z" fill="currentColor"/></svg>
          <svg class="tl-pause" width="16" height="18" viewBox="0 0 12 14" aria-hidden="true"><path d="M0 0h4v14H0zM8 0h4v14H8z" fill="currentColor"/></svg>
        </button>
        <span class="min-w-0">
          <span class="tl-now-eyebrow eyebrow block text-stone">Press play</span>
          <strong class="tl-now-title block truncate text-[18px]">{tracks[0].title}</strong>
        </span>
      </div>
    </div>
  )}
  <ol class="tl-list m-0 list-none p-0">
    {tracks.map((t, i) => (
      <li class="tl-row rule relative border-t" data-src={t.src} data-title={t.title}>
        <div class="flex items-center gap-3 py-2 md:gap-4">
          <button type="button" class="tl-btn grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border border-stone/50 text-white transition-colors hover:border-white hover:bg-white hover:text-black" aria-label={`Play ${t.title}`}>
            <svg class="tl-play ml-0.5" width="12" height="14" viewBox="0 0 16 18" aria-hidden="true"><path d="M0 0l16 9-16 9z" fill="currentColor"/></svg>
            <svg class="tl-pause" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M0 0h4v14H0zM8 0h4v14H8z" fill="currentColor"/></svg>
          </button>
          <span class="tl-num w-6 shrink-0 text-sm tabular-nums text-stone">{String(i + 1).padStart(2, "0")}</span>
          <span class="tl-eq w-6 shrink-0" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="min-w-0 flex-1 leading-tight">
            <strong class="line-clamp-2 block text-[16px] md:text-[18px]">{t.title}</strong>
            {t.credit && <span class="block truncate text-sm text-stone">{t.credit}</span>}
          </span>
          <span class="tl-time shrink-0 text-sm tabular-nums text-stone" aria-hidden="true">--:--</span>
        </div>
        <input type="range" class="tl-seek" min="0" max="1000" step="1" value="0" disabled aria-label={`Seek in ${t.title}`} />
      </li>
    ))}
  </ol>
  <p class="tl-error m-0 hidden pt-3 text-sm text-stone" role="status"></p>
</div>

<style>
  .tl-pause { display: none; }
  .tl-row.playing .tl-play, .tracklist.is-playing .tl-big .tl-play { display: none; }
  .tl-row.playing .tl-pause, .tracklist.is-playing .tl-big .tl-pause { display: block; }

  /* Deck layout: sleeve + now playing on the left, a narrower list on the right. */
  .tl-has-deck { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 761px) {
    .tl-has-deck { grid-template-columns: minmax(0, 340px) minmax(0, 560px); gap: 48px; align-items: start; }
    .tl-deck { position: sticky; top: 112px; }
  }
  /* Phones: a small sleeve beside the play button. Wider screens: the full sleeve above it. */
  .tl-deck { display: flex; align-items: center; gap: 18px; }
  .tl-sleeve { position: relative; aspect-ratio: 1; width: 104px; flex-shrink: 0; margin-right: 18px; }
  @media (min-width: 761px) {
    .tl-deck { flex-direction: column; align-items: stretch; max-width: 340px; }
    .tl-sleeve { width: 82%; margin-right: 0; }
  }
  .tl-cover { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; border-radius: 6px; box-shadow: 0 18px 40px rgb(0 0 0 / .45); }
  .tl-disc {
    position: absolute; inset: 3%; border-radius: 50%; z-index: 0;
    background: repeating-radial-gradient(circle, #111 0 2px, #1c1c1e 2px 4px);
    box-shadow: 0 10px 30px rgb(0 0 0 / .5);
    transform: translateX(0); transition: transform .6s cubic-bezier(.2,.7,.2,1);
  }
  .tl-label { position: absolute; inset: 34%; border-radius: 50%; background: var(--color-stone); }
  .tl-label::after { content: ""; position: absolute; inset: 44%; border-radius: 50%; background: #111; }
  .tracklist.is-active .tl-disc { transform: translateX(22%); }
  .tracklist.is-playing .tl-disc { animation: tl-spin 1.8s linear infinite; }
  @keyframes tl-spin { from { transform: translateX(22%) rotate(0); } to { transform: translateX(22%) rotate(360deg); } }
  .tl-now { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .tl-big {
    display: grid; place-items: center; flex-shrink: 0; width: 60px; height: 60px; border-radius: 50%;
    background: var(--color-white); color: var(--color-black); border: 0; cursor: pointer; transition: transform .15s;
  }
  .tl-big:hover { transform: scale(1.06); }
  .tl-big:focus-visible { outline: 2px solid var(--color-white); outline-offset: 4px; }
  .tl-now-eyebrow { font-size: 11px; }

  /* Equalizer in place of the track number while a track plays. */
  .tl-eq { display: none; height: 14px; align-items: flex-end; gap: 2px; }
  .tl-eq i { display: block; width: 3px; height: 100%; background: var(--color-white); transform-origin: bottom; animation: tl-eq .9s ease-in-out infinite; }
  .tl-eq i:nth-child(2) { animation-delay: -.3s; }
  .tl-eq i:nth-child(3) { animation-delay: -.6s; }
  @keyframes tl-eq { 0%, 100% { transform: scaleY(.25); } 50% { transform: scaleY(1); } }
  .tl-row.playing .tl-num { display: none; }
  .tl-row.playing .tl-eq { display: flex; }
  .tl-row.active strong { color: var(--color-white); }
  .tl-row:not(.active) strong { color: rgb(255 255 255 / .88); }
  .tl-row.active .tl-btn { background: var(--color-white); color: var(--color-black); border-color: var(--color-white); }
  .tl-row.active .tl-time { color: var(--color-white); }
  .tl-row.loading .tl-btn { animation: tl-pulse 1s ease-in-out infinite; }
  @keyframes tl-pulse { 50% { opacity: 0.5; } }

  /* Thin progress line on every row; becomes a draggable seek bar on the active one. */
  .tl-seek {
    --p: 0%;
    /* A 3px bar drawn in a 24px-tall hit area (centered on the row's bottom edge) so it is tappable. */
    position: absolute; inset-inline: 0; bottom: -12px; z-index: 1;
    width: 100%; height: 24px; margin: 0;
    appearance: none; -webkit-appearance: none; background: transparent; cursor: pointer;
  }
  .tl-seek:disabled { cursor: default; pointer-events: none; }
  .tl-seek::-webkit-slider-runnable-track { height: 3px; background: linear-gradient(to right, var(--color-white) var(--p), transparent var(--p)); border-radius: 2px; }
  .tl-seek::-moz-range-track { height: 3px; background: linear-gradient(to right, var(--color-white) var(--p), transparent var(--p)); border-radius: 2px; }
  .tl-seek::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; margin-top: -4.5px; border-radius: 50%; background: var(--color-white); opacity: 0; transition: opacity .2s; }
  .tl-seek::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: var(--color-white); opacity: 0; }
  .tl-row.active .tl-seek::-webkit-slider-thumb { opacity: 1; }
  .tl-row.active .tl-seek::-moz-range-thumb { opacity: 1; }
  .tl-seek:focus-visible { outline: 2px solid var(--color-white); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .tl-row.loading .tl-btn, .tl-eq i, .tracklist.is-playing .tl-disc { animation: none; }
    .tl-disc { transition: none; }
  }
</style>

<script>
  const fmt = (s: number) => (isFinite(s) && s >= 0 ? `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}` : "--:--");

  function init() {
    document.querySelectorAll<HTMLElement>("[data-tracklist]").forEach((list) => {
      if (list.dataset.ready) return;
      list.dataset.ready = "1";
      const audio = list.querySelector("audio")!;
      const rows = [...list.querySelectorAll<HTMLLIElement>(".tl-row")];
      const err = list.querySelector<HTMLElement>(".tl-error")!;
      let current: HTMLLIElement | null = null;

      const seekOf = (r: HTMLLIElement) => r.querySelector<HTMLInputElement>(".tl-seek")!;
      const timeOf = (r: HTMLLIElement) => r.querySelector<HTMLElement>(".tl-time")!;
      const btnOf = (r: HTMLLIElement) => r.querySelector<HTMLButtonElement>(".tl-btn")!;
      const title = (r: HTMLLIElement) => r.dataset.title!;
      const big = list.querySelector<HTMLButtonElement>(".tl-big");
      const nowTitle = list.querySelector<HTMLElement>(".tl-now-title");
      const nowEyebrow = list.querySelector<HTMLElement>(".tl-now-eyebrow");

      const paint = () => {
        if (!current) return;
        const d = audio.duration, t = audio.currentTime;
        const p = d ? (t / d) * 100 : 0;
        const seek = seekOf(current);
        seek.style.setProperty("--p", `${p}%`);
        if (document.activeElement !== seek) seek.value = String(Math.round(p * 10));
        seek.setAttribute("aria-valuetext", `${fmt(t)} of ${fmt(d)}`);
        timeOf(current).textContent = d ? `${fmt(t)} / ${fmt(d)}` : fmt(t);
      };
      const setState = () => {
        rows.forEach((r) => {
          const on = r === current;
          const playing = on && !audio.paused;
          r.classList.toggle("active", on);
          r.classList.toggle("playing", playing);
          if (audio.paused) r.classList.remove("loading");
          btnOf(r).setAttribute("aria-label", `${playing ? "Pause" : "Play"} ${title(r)}`);
          seekOf(r).disabled = !on;
        });
        const playing = Boolean(current) && !audio.paused;
        list.classList.toggle("is-active", Boolean(current));
        list.classList.toggle("is-playing", playing);
        const shown = current ?? rows[0];
        if (nowTitle) nowTitle.textContent = title(shown);
        if (nowEyebrow) nowEyebrow.textContent = playing ? "Now playing" : current ? "Paused" : "Press play";
        big?.setAttribute("aria-label", `${playing ? "Pause" : "Play"} ${title(shown)}`);
      };

      const select = (r: HTMLLIElement) => {
        if (current && current !== r) {
          const old = current;
          seekOf(old).value = "0";
          seekOf(old).style.setProperty("--p", "0%");
          if (audio.duration) timeOf(old).textContent = fmt(audio.duration);
        }
        current = r;
        err.classList.add("hidden");
        audio.src = r.dataset.src!;
      };

      const play = () => {
        // One at a time, page-wide.
        document.querySelectorAll("audio").forEach((a) => a !== audio && a.pause());
        current?.classList.add("loading");
        audio.play().catch(() => {});
      };

      big?.addEventListener("click", () => {
        if (!current) { select(rows[0]); play(); }
        else if (audio.paused) play();
        else audio.pause();
      });

      rows.forEach((r, i) => {
        btnOf(r).addEventListener("click", () => {
          if (r !== current) { select(r); play(); }
          else if (audio.paused) play();
          else audio.pause();
        });
        const seek = seekOf(r);
        seek.addEventListener("input", () => {
          if (r !== current || !audio.duration) return;
          audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
          seek.style.setProperty("--p", `${Number(seek.value) / 10}%`);
        });
        // Keyboard: arrow up/down on a play button moves between tracks.
        btnOf(r).addEventListener("keydown", (e) => {
          const k = e.key === "ArrowDown" ? 1 : e.key === "ArrowUp" ? -1 : 0;
          if (!k) return;
          e.preventDefault();
          btnOf(rows[(i + k + rows.length) % rows.length]).focus();
        });
      });

      audio.addEventListener("play", setState);
      audio.addEventListener("pause", setState);
      audio.addEventListener("playing", () => current?.classList.remove("loading"));
      audio.addEventListener("timeupdate", paint);
      audio.addEventListener("loadedmetadata", paint);
      audio.addEventListener("ended", () => {
        const next = current ? rows[rows.indexOf(current) + 1] : undefined;
        if (next) { select(next); play(); } else { current && (seekOf(current).value = "0"); setState(); }
      });
      audio.addEventListener("error", () => {
        current?.classList.remove("loading");
        err.textContent = current ? `Couldn't load “${title(current)}”. Try again in a moment.` : "";
        err.classList.remove("hidden");
        setState();
      });
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
  // Stop playback before the page swaps, or the detached <audio> keeps playing.
  document.addEventListener("astro:before-swap", () => document.querySelectorAll<HTMLAudioElement>("[data-tracklist] audio").forEach((a) => a.pause()));
</script>
