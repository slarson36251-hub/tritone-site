---
import { Image } from "astro:assets";
import logo from "../assets/logo/tritone-wordmark-white.png";
import Pill from "./Pill.astro";
import { nav, bookHref } from "../lib/nav";

const path = Astro.url.pathname;
---
<header class="sticky top-0 z-30 border-b border-stone/25 bg-charcoal/80 backdrop-blur-xl backdrop-saturate-150" transition:persist="site-header">
  <div class="wrap flex items-center justify-between gap-6 py-3">
    <a href="/" class="shrink-0" aria-label="Tritone Productions, home">
      <Image src={logo} alt="Tritone Productions" class="h-11 w-auto md:h-14" widths={[240, 480]} sizes="160px" loading="eager" />
    </a>

    <nav class="hidden items-center gap-1 xl:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          data-nav={item.href}
          class:list={[
            "inline-flex min-h-11 items-center whitespace-nowrap rounded-full px-3.5 py-2 font-semibold no-underline transition-colors hover:bg-stone/15",
            path.startsWith(item.href) && "bg-stone/20",
          ]}
        >{item.label}</a>
      ))}
      <span class="ml-3"><Pill href={bookHref}>Book the Hut</Pill></span>
    </nav>

    <details class="group xl:hidden" id="mnav">
      <summary class="flex min-h-12 cursor-pointer list-none items-center gap-2 font-semibold uppercase tracking-[.04em] [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="2"/></svg>
      </summary>
      <nav class="absolute inset-x-0 top-full flex h-[calc(100dvh-100%)] flex-col gap-1 bg-charcoal px-4 pb-10 pt-4" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} class="disp border-b border-stone/30 py-4 text-3xl no-underline">{item.label}</a>
        ))}
        <div class="pt-6"><Pill href={bookHref}>Book the Hut</Pill></div>
      </nav>
    </details>
  </div>
</header>

<script>
  // The header persists across page swaps, so update the active link and close the menu ourselves.
  // The mobile menu (<details id="mnav">) acts as a modal while open: Escape closes it and returns
  // focus to its button, everything outside the header is inert, and the page behind cannot scroll.
  const menu = () => document.getElementById("mnav") as HTMLDetailsElement | null;

  function syncMenu() {
    const m = menu();
    const open = !!m?.open;
    document.documentElement.classList.toggle("menu-open", open);
    const header = m?.closest("header");
    for (const el of document.body.children) {
      if (el === header) continue;
      if (open) el.setAttribute("inert", "");
      else el.removeAttribute("inert");
    }
  }

  function initMenu() {
    const m = menu();
    if (!m || m.dataset.ready) return; // persisted element: wire up once
    m.dataset.ready = "1";
    m.addEventListener("toggle", syncMenu);
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !m.open) return;
      e.preventDefault();
      m.open = false;
      syncMenu();
      m.querySelector("summary")?.focus();
    });
    // The menu is hidden from xl up; never leave the page inert behind an invisible menu.
    matchMedia("(min-width: 80rem)").addEventListener("change", (e) => {
      if (e.matches && m.open) { m.open = false; syncMenu(); }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const path = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>("[data-nav]").forEach((a) => {
      a.classList.toggle("bg-stone/20", path.startsWith(a.dataset.nav!));
    });
    menu()?.removeAttribute("open");
    syncMenu();
  });
  initMenu();
  document.addEventListener("astro:page-load", initMenu);
</script>

<style is:global>
  html.menu-open { overflow: hidden; }
  /* The open menu covers the page; keep the player dock from sitting over its last links. */
  html.menu-open #dock { visibility: hidden; }
</style>
