---
import { Image } from "astro:assets";
import logo from "../assets/logo/tritone-wordmark-white.png";
import Pill from "./Pill.astro";
import { nav, bookHref } from "../lib/nav";

const path = Astro.url.pathname;
---
<header class="sticky top-0 z-20 border-b border-stone/40 bg-charcoal">
  <div class="wrap flex items-center justify-between gap-6 py-4">
    <a href="/" class="shrink-0" aria-label="Tritone Productions, home">
      <Image src={logo} alt="Tritone Productions" class="h-12 w-auto md:h-16" widths={[240, 480]} sizes="160px" loading="eager" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={["font-semibold no-underline hover:underline", path.startsWith(item.href) && "underline underline-offset-4"]}
        >{item.label}</a>
      ))}
      <Pill href={bookHref}>Book the Hut</Pill>
    </nav>

    <details class="group lg:hidden">
      <summary class="flex min-h-12 cursor-pointer list-none items-center gap-2 font-semibold uppercase tracking-[.04em] [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="2"/></svg>
      </summary>
      <nav class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-stone/40 bg-charcoal px-4 pb-6 pt-2" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} class="border-b border-stone/30 py-3 text-lg font-semibold no-underline">{item.label}</a>
        ))}
        <div class="pt-4"><Pill href={bookHref}>Book the Hut</Pill></div>
      </nav>
    </details>
  </div>
</header>
