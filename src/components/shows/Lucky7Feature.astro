---
// Link to the Lucky 7 show page while the show is still ahead. The site rebuilds every
// two hours, so this disappears on its own the day after the show.
const SHOW_END = Date.parse("2026-12-16T00:00:00-08:00");
const live = Date.now() < SHOW_END;
interface Props { class?: string }
const { class: cls } = Astro.props;
---
{live && (
  <a href="/lucky-7-woodchoppers-ball" class:list={["group flex items-center justify-between gap-4 rounded-md border border-stone/40 bg-black/20 p-5 no-underline hover:border-white md:p-6", cls]}>
    <span class="flex min-w-0 flex-col gap-1">
      <span class="eyebrow text-white/80">Tue Dec 15 · Verdi Club, San Francisco</span>
      <span class="disp text-[1.5rem] leading-tight">Lucky 7 at the Woodchopper’s Ball</span>
      <span class="text-[15px] text-white/80">Featuring Allegra Bandy · sets at 9:15 and 10:30</span>
    </span>
    <span class="text-2xl transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
  </a>
)}
