---
// Gig poster (11:17) or the typographic stand-in. `name` is the view-transition name
// shared by a show's card and its page, so the poster morphs between them.
import type { Show } from "../../lib/shows";
import PosterFallback from "./PosterFallback.astro";
import { fullDate } from "./format";

interface Props { show: Show; eager?: boolean; compactFallback?: boolean; class?: string }
const { show, eager = false, compactFallback = false, class: cls } = Astro.props;
---
<div
  transition:name={`poster-${show.slug}`}
  class:list={[
    "relative w-full overflow-hidden bg-black/30",
    show.poster || !compactFallback ? "aspect-[11/17]" : "aspect-[4/3] sm:aspect-[11/17]",
    cls,
  ]}
>
  {show.poster ? (
    <img
      src={show.poster}
      alt={`Poster: ${show.band}, ${fullDate(show)}`}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      referrerpolicy="no-referrer"
      width="1100"
      height="1700"
      class="h-full w-full object-cover"
    />
  ) : (
    <PosterFallback show={show} />
  )}
  {(show.cancelled || show.rescheduled) && (
    <span class="eyebrow absolute left-4 top-4 rounded-full bg-white px-3 py-1 text-charcoal">{show.cancelled ? "Cancelled" : "Rescheduled"}</span>
  )}
</div>
