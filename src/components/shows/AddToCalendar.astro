---
import { googleCalendarUrl, type Show } from "../../lib/shows";
interface Props { show: Show }
const { show } = Astro.props;
const btn = "inline-flex min-h-11 items-center justify-center rounded-full border border-stone/60 px-4 text-sm font-semibold no-underline transition-colors hover:border-white";
---
<div class="flex flex-col gap-2">
  <span class="eyebrow text-[13px] text-white/80">Add to calendar</span>
  <div class="flex flex-wrap gap-2">
    <a href={googleCalendarUrl(show)} target="_blank" rel="noopener" class={btn} aria-label={`Google: add ${show.title} to Google Calendar`}>Google</a>
    <a href={`/shows/${show.slug}.ics`} download={`${show.slug}.ics`} class={btn} aria-label={`Apple / Outlook: download ${show.title} as a calendar file`}>Apple / Outlook</a>
  </div>
</div>
