---
// Typographic stand-in for a missing gig poster: big date, band, venue, wordmark.
import { Image } from "astro:assets";
import logo from "../../assets/logo/tritone-wordmark-white.png";
import { dateParts, place, startTime } from "./format";
import type { Show } from "../../lib/shows";
interface Props { show: Show }
const { show } = Astro.props;
const { day, mon, num } = dateParts(show.start);
---
<div class="flex h-full w-full flex-col justify-between bg-black/35 p-5 sm:p-6 md:p-7" aria-hidden="true">
  <div class="flex items-start justify-between gap-4">
    <span class="eyebrow text-stone">{day} · {startTime(show)}</span>
    <span class="eyebrow">{mon}</span>
  </div>
  <div class="flex flex-col gap-3 max-sm:gap-2">
    <span class="disp text-[6.5rem] leading-[.8] tracking-[-0.04em] sm:text-[clamp(6rem,11vw,9rem)]">{num}</span>
    <span class="block h-1 w-14 bg-stone"></span>
    <span class="disp line-clamp-3 text-[1.6rem] leading-[.95] sm:text-[2rem]">{show.band}</span>
    <span class="font-semibold uppercase tracking-[.06em] text-stone">{place(show)}</span>
  </div>
  <Image src={logo} alt="" widths={[200, 400]} sizes="120px" class="h-auto w-[7.5rem] opacity-90 max-sm:hidden" />
</div>
