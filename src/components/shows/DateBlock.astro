---
// DAY / MON / NUM date block. `size` md for cards, sm for compact rows.
import { dateParts } from "./format";
interface Props { date: Date; size?: "sm" | "md" | "lg"; name?: string }
const { date, size = "md", name } = Astro.props;
const { day, mon, num } = dateParts(date);
---
<time
  datetime={date.toISOString()}
  transition:name={name}
  class:list={[
    "flex shrink-0 flex-col items-center justify-center rounded-md border border-stone/60 text-center leading-none",
    size === "lg" ? "w-[6rem] gap-1.5 py-4" : size === "md" ? "w-[4.75rem] gap-1 py-3" : "w-[3.75rem] gap-0.5 py-2",
  ]}
>
  <span class="eyebrow text-[14px] tracking-[.16em] text-white/80">{day}</span>
  <span class:list={["font-semibold uppercase tracking-[.08em]", size === "sm" ? "text-[14px]" : size === "lg" ? "text-[15px]" : "text-[14px]"]}>{mon}</span>
  <span class:list={["disp tracking-normal", size === "lg" ? "text-[2.8rem]" : size === "md" ? "text-[2.1rem]" : "text-[1.55rem]"]}>{num}</span>
</time>
