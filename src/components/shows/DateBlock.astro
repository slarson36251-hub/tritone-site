---
// DAY / MON / NUM date block. `size` md for cards, sm for compact rows.
import { dateParts } from "./format";
interface Props { date: Date; size?: "sm" | "md" }
const { date, size = "md" } = Astro.props;
const { day, mon, num } = dateParts(date);
---
<time
  datetime={date.toISOString()}
  class:list={[
    "flex shrink-0 flex-col items-center justify-center rounded-md border border-stone/60 text-center leading-none",
    size === "md" ? "w-[4.75rem] gap-1 py-3" : "w-[3.75rem] gap-0.5 py-2",
  ]}
>
  <span class="eyebrow text-[11px] tracking-[.16em] text-stone">{day}</span>
  <span class:list={["font-semibold uppercase tracking-[.08em]", size === "md" ? "text-[13px]" : "text-[11px]"]}>{mon}</span>
  <span class:list={["disp tracking-normal", size === "md" ? "text-[2.1rem]" : "text-[1.55rem]"]}>{num}</span>
</time>
