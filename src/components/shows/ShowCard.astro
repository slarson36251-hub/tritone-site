---
import type { Show } from "../../lib/shows";
import DateBlock from "./DateBlock.astro";
import Poster from "./Poster.astro";
import { fullDate, timeRange } from "./format";

interface Props { show: Show; eager?: boolean }
const { show, eager = false } = Astro.props;
---
<article class="group relative flex min-w-0 flex-col overflow-hidden rounded-md border border-stone/40 bg-white/[.03] transition-colors hover:border-white/70" aria-labelledby={`show-${show.id}`}>
  {show.poster && <Poster show={show} eager={eager} />}

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div class="flex items-start gap-3">
      <DateBlock date={show.start} name={`date-${show.slug}`} />
      <div class="flex min-w-0 flex-col gap-0.5">
        <h3 id={`show-${show.id}`} class:list={["disp m-0 text-[1.2rem] leading-[1.05] [overflow-wrap:anywhere]", show.cancelled && "line-through decoration-2"]}>
          <a href={`/shows/${show.slug}`} class="no-underline after:absolute after:inset-0 after:content-[''] group-hover:underline">{show.band}</a>
        </h3>
        <p class="m-0 text-[15px] font-semibold leading-snug">{show.venue}</p>
        <p class="m-0 text-[15px] leading-snug text-white/80">
          {show.city && show.city !== show.venue && <span class="whitespace-nowrap">{show.city} · </span>}
          <span class="sr-only">{fullDate(show)}, </span><span class="whitespace-nowrap">{timeRange(show)}</span>
        </p>
      </div>
    </div>

    <div class="mt-auto flex items-center justify-between gap-3 border-t border-stone/30 pt-3">
      <span class="text-sm font-semibold" aria-hidden="true">{show.cancelled ? "Cancelled" : "Details, lineup, add to calendar"} <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
      {show.tickets && !show.cancelled && <a href={show.tickets} target="_blank" rel="noopener" data-track="ticket_click" data-track-lbl={show.slug} class="relative z-10 shrink-0 text-sm font-semibold">Tickets ↗</a>}
    </div>
  </div>
</article>
