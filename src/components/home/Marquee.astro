---
import { getCollection } from "astro:content";
const bands = (await getCollection("bands")).sort((a, b) => a.data.order - b.data.order).map((b) => b.data.name);
const row = [...bands, ...bands];
---
<div class="overflow-hidden border-y border-stone/30 py-5" aria-label={`Tritone bands: ${bands.join(", ")}`}>
  <div class="marquee" aria-hidden="true">
    {[0, 1].map(() => row.map((name, i) => (
      <span class:list={["disp whitespace-nowrap px-6 text-[clamp(1.6rem,4vw,3rem)] leading-none", i % 2 && "outline-type"]}>
        {name}<span class="pl-12 text-stone">✦</span>
      </span>
    )))}
  </div>
</div>
