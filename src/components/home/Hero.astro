---
import { Image } from "astro:assets";
import Pill from "../Pill.astro";
import photo from "../../assets/photos/fault-line-trio-drums-tracking-oct-2024-hummingbird-hut-oakland.jpg";
---
<section class="wrap grid items-end gap-8 pb-10 pt-8 md:grid-cols-12 md:gap-10 md:pb-16 md:pt-14">
  <div class="flex flex-col gap-6 md:col-span-7">
    <p class="eyebrow m-0 flex items-center gap-3">
      <span class="inline-block size-2 rounded-full bg-white motion-safe:animate-pulse" aria-hidden="true"></span>
      Recording studio · Music production · Oakland, CA
    </p>
    <h1 class="disp m-0 text-[clamp(2.4rem,5.4vw,4.8rem)] leading-[0.92]">
      Oakland music, <span class="outline-type">recorded right</span> and played live.
    </h1>
    <p class="m-0 max-w-[560px] text-[19px] text-white/90">
      Tritone Productions is music production in Oakland: the Hummingbird Hut, a private recording studio, and a family of Bay Area jazz groups, run by trombonist Scott Larson.
    </p>
    <div class="flex flex-wrap gap-3.5">
      <Pill href="/sessions">Hear the work</Pill>
      <Pill href="/shows" ghost>Upcoming shows</Pill>
    </div>
  </div>
  <div class="relative md:col-span-5">
    <Image
      src={photo}
      alt="Fault Line Trio drums set up for tracking at the Hummingbird Hut, Oakland, CA"
      widths={[480, 720, 960]}
      sizes="(min-width: 761px) 40vw, 100vw"
      loading="eager"
      fetchpriority="high"
      transition:name="hero-photo"
      class="aspect-4/3 h-auto w-full rounded-[18px] object-cover md:aspect-4/5"
    />
    <p class="absolute bottom-3 left-3 m-0 rounded-full bg-black/70 px-3 py-1.5 text-xs font-semibold backdrop-blur">In the live room · Fault Line Trio</p>
  </div>
</section>
