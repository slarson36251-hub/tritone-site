---
import { getCollection } from "astro:content";
import Pill from "../Pill.astro";

const [release] = await getCollection("releases", ({ data }) => data.featured);
---
{release && (
  <section class="border-y border-stone bg-charcoal py-14 md:py-18">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-1.5 mt-0">Fresh from the Hut</p>
          <h2 class="disp m-0 text-[clamp(2rem,4.5vw,2.75rem)] leading-[1.05]">{release.data.artist}</h2>
          <p class="mb-0 mt-2">{release.data.credits}</p>
        </div>
        {release.data.listenUrl && <Pill href={release.data.listenUrl} external>{release.data.listenLabel}</Pill>}
      </div>
      <ol class="rule mt-7 list-none border-t p-0">
        {release.data.tracks.map((t) => (
          <li class="rule flex flex-wrap justify-between gap-2 border-b px-1 py-4">
            <strong class="text-[19px]">{t.title}</strong><span>{t.note}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
