---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import studioPhoto from "../../assets/photos/fault-line-trio-piano-mics-feb-2026-hummingbird-hut-oakland.jpg";
import logo from "../../assets/logo/tritone-wordmark-white.png";

const bands = (await getCollection("bands")).sort((a, b) => a.data.order - b.data.order);
const imgClass = "aspect-3/2 h-auto w-full rounded-md bg-stone/20 object-cover";
---
<section class="wrap grid gap-8 py-20 md:grid-cols-2 md:gap-7">
  <a href="/hummingbird-hut" class="group flex flex-col gap-4 no-underline">
    <Image src={studioPhoto} alt="Grand piano with a stereo pair of condenser mics at the Hummingbird Hut, Oakland, CA" widths={[480, 720, 960]} sizes="(min-width: 761px) 45vw, 100vw" class={imgClass} />
    <h3 class="disp m-0 text-3xl">Hummingbird Hut</h3>
    <p class="m-0">A private studio in Oakland built for small acoustic groups: real room, ribbon and condenser pairs, tube preamps. Tracking, overdubs, mixing and mastering.</p>
    <span class="font-semibold group-hover:underline">Sessions and portfolio →</span>
  </a>
  <a href="/bands" class="group flex flex-col gap-4 no-underline">
    {/* TODO: swap for a live band photo from Scott (e.g. Hard Bop Quintet at Club Deluxe). */}
    <div class={`${imgClass} grid place-items-center`}>
      <Image src={logo} alt="" widths={[480]} sizes="40vw" class="h-auto w-1/2" />
    </div>
    <h3 class="disp m-0 text-3xl">The Bands</h3>
    <p class="m-0">{bands.map((b) => b.data.name).join(" · ")}. Hard bop, boogaloo, afro-cuban and down-home blues, booked for clubs, parties and festivals.</p>
    <span class="font-semibold group-hover:underline">Meet the bands →</span>
  </a>
</section>
