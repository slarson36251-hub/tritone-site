---
import { getUpcomingShows } from "../../lib/shows";
import ShowRow from "../shows/ShowRow.astro";

const shows = await getUpcomingShows(3);
---
<section class="wrap py-18">
  <div class="rule border-t pt-0"></div>
  <div class="pt-18">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <h2 class="disp m-0 text-[clamp(2rem,4.5vw,2.5rem)]">Next up</h2>
    <a href="/shows" class="font-semibold">All shows →</a>
  </div>
  {shows.length ? (
    <ul class="rule m-0 list-none border-t p-0">
      {shows.map((s) => <ShowRow show={s} href={`/shows/${s.slug}`} />)}
    </ul>
  ) : (
    <p class="m-0">Dates, venues and add-to-calendar links are on the <a href="/shows">Shows page</a>.</p>
  )}
  </div>
</section>
