{
  "name": "tritone-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/privacy-check.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tritone-rules \"node --test tests/rules/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "firebase-tools": "15.34.1",
    "opentype.js": "1.3.4"
  }
}
