{
  "hosting": {
    "site": "tritone-site",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.ics",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/calendar; charset=utf-8"
          }
        ]
      },
      {
        "source": "/audio/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/hard-bop-quintet",
        "destination": "/bands/hard-bop-quintet",
        "type": 301
      },
      {
        "source": "/franco-nero",
        "destination": "/bands/franco-nero",
        "type": 301
      },
      {
        "source": "/lucky-7",
        "destination": "/bands/lucky-7",
        "type": 301
      },
      {
        "source": "/about",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/new-album",
        "destination": "/listen",
        "type": 301
      },
      {
        "source": "/that-was-then-v1",
        "destination": "/listen",
        "type": 301
      },
      {
        "source": "/turquoise-moon",
        "destination": "/listen",
        "type": 301
      },
      {
        "source": "/the-distance-between-us",
        "destination": "/listen",
        "type": 301
      },
      {
        "source": "/s/**",
        "destination": "/gallery",
        "type": 301
      }
    ]
  }
}
